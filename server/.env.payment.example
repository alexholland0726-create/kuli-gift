# WeChat Pay V3 / Mini Program JSAPI payment
# Fill these in server/.env on the production server. Do not commit real values.

# Mini Program AppID. Existing WECHAT_APPID can also be used by the code.
WX_APPID=wx9194755d087b4120

# Merchant ID from WeChat Pay merchant platform.
WX_MCHID=

# API v3 key. Must be exactly 32 bytes.
WX_API_V3_KEY=

# Merchant API certificate serial number.
WX_CERT_SERIAL=

# Prefer a file path for the merchant private key on the server.
WX_PRIVATE_KEY_PATH=/www/kuli/server/certs/apiclient_key.pem

# WeChat Pay platform certificate used to verify payment notifications.
WX_PLATFORM_CERT_PATH=/www/kuli/server/certs/wechatpay_platform.pem

# Alternative: inline private key. Escape newlines as \n if using this.
# WX_PRIVATE_KEY=

# Public HTTPS callback URL configured for payment notifications.
WX_NOTIFY_URL=https://api.da-fire.com/api/pay/notify
